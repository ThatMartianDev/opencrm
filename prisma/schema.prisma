// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Multi-tenant Foundation ───

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  plan      String   @default("free")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             Member[]
  companies           Company[]
  contacts            Contact[]
  deals               Deal[]
  tasks               Task[]
  notes               Note[]
  tags                Tag[]
  activities          Activity[]
  files               File[]
  invitations         Invitation[]
  calendarEvents      CalendarEvent[]
  emails              Email[]
  accounts            Account[]
  notifications       Notification[]
  recordModules       RecordModule[]
  recordItems         RecordItem[]
  recordRelationships RecordRelationship[]
  aiThreads           AiThread[]

  @@map("organizations")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  passwordHash  String?
  emailVerified Boolean   @default(false)
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships Member[]
  accounts    Account[]

  @@map("users")
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  organizationId    String?
  provider          String // "google" | "google_calendar"
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  scope             String?
  syncToken         String? // For Google Calendar incremental sync
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, provider, providerAccountId])
  @@index([organizationId])
  @@map("accounts")
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, code])
  @@map("email_verifications")
}

model Member {
  id             String     @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole @default(MEMBER)
  permissions    String[]   @default([])
  joinedAt       DateTime   @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  assignedDeals            Deal[]             @relation("AssignedDeals")
  assignedTasks            Task[]             @relation("AssignedTasks")
  activities               Activity[]
  createdNotes             Note[]             @relation("NoteCreator")
  createdDeals             Deal[]             @relation("DealCreator")
  createdContacts          Contact[]          @relation("ContactCreator")
  createdCompanies         Company[]          @relation("CompanyCreator")
  createdTasks             Task[]             @relation("TaskCreator")
  createdRecordModuleViews RecordModuleView[] @relation("RecordModuleViewCreator")
  createdRecords           RecordItem[]       @relation("RecordItemCreator")
  ownedRecords             RecordItem[]       @relation("RecordItemOwner")
  notifications            Notification[]
  aiThreads                AiThread[]

  @@unique([userId, organizationId])
  @@map("members")
}

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

// ─── AI Platform ───

model AiThread {
  id             String         @id @default(cuid())
  organizationId String
  memberId       String
  feature        String
  title          String?
  status         AiThreadStatus @default(ACTIVE)
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  runs         AiRun[]

  @@index([organizationId, memberId, feature, status])
  @@index([memberId, updatedAt])
}

model AiRun {
  id          String      @id @default(cuid())
  threadId    String
  status      AiRunStatus @default(PENDING)
  input       Json
  context     Json        @default("{}")
  response    Json?
  error       String?
  model       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  thread  AiThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  actions AiRunAction[]

  @@index([threadId, createdAt])
  @@index([status, createdAt])
}

model AiRunAction {
  id             String            @id @default(cuid())
  runId          String
  actionKey      String
  type           String
  ordinal        Int
  payload        Json
  status         AiRunActionStatus @default(PROPOSED)
  idempotencyKey String            @unique
  result         Json?
  error          String?
  approvedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  run AiRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, actionKey])
  @@unique([runId, ordinal])
  @@index([runId, status])
}

enum AiThreadStatus {
  ACTIVE
  ARCHIVED
}

enum AiRunStatus {
  PENDING
  RUNNING
  AWAITING_INPUT
  AWAITING_APPROVAL
  EXECUTING
  COMPLETED
  FAILED
  CANCELLED
}

enum AiRunActionStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXECUTING
  COMPLETED
  FAILED
}

model Invitation {
  id             String     @id @default(cuid())
  email          String
  token          String     @unique
  role           MemberRole @default(MEMBER)
  organizationId String
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([email, organizationId])
  @@map("invitations")
}

// ─── Core CRM Models ───

// Record Module

model RecordModule {
  id             String @id @default(cuid())
  organizationId String

  key        String
  name       String
  pluralName String?

  icon        String
  accentColor String?

  features ModuleFeature[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  fields                       RecordField[]
  records                      RecordItem[]
  views                        RecordModuleView[]
  relationshipFieldDefinitions RecordRelationshipDefinition[] @relation("RelationshipTargetModule")

  @@unique([organizationId, key])
  @@index([organizationId])
}

model RecordModuleView {
  id String @id @default(cuid())

  moduleId String
  module   RecordModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  name String

  type RecordViewType

  position Int @default(0)

  isDefault Boolean @default(false)

  config Json?

  createdById String?
  createdBy   Member? @relation("RecordModuleViewCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model RecordField {
  id String @id @default(cuid())

  moduleId String
  module   RecordModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  key   String
  label String

  type RecordFieldType

  required Boolean @default(false)
  unique   Boolean @default(false)

  isPrimary Boolean @default(false)
  isSystem  Boolean @default(false)

  position Int @default(0)

  config       Json?
  defaultValue Json?

  values                 RecordFieldValue[]
  relationshipDefinition RecordRelationshipDefinition?
  relationships          RecordRelationship[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, key])
  @@index([moduleId])
  @@index([moduleId, position])
}

model RecordItem {
  id String @id @default(cuid())

  organizationId String
  moduleId       String

  displayName String

  module       RecordModule @relation(fields: [moduleId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  values                RecordFieldValue[]
  outgoingRelationships RecordRelationship[] @relation("RelationshipSource")
  incomingRelationships RecordRelationship[] @relation("RelationshipTarget")

  notes Note[]
  tasks Task[]
  files File[]
  activities Activity[]

  createdById String?
  createdBy   Member? @relation("RecordItemCreator", fields: [createdById], references: [id])

  ownerId String
  owner   Member @relation("RecordItemOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([organizationId])
  @@index([moduleId])
  @@index([organizationId, moduleId])
  @@index([organizationId, ownerId])
  @@index([moduleId, ownerId])
}

model RecordFieldValue {
  id String @id @default(cuid())

  recordId String
  fieldId  String

  value           Json
  normalizedValue String?

  record RecordItem  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  field  RecordField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([recordId, fieldId])
  @@unique([fieldId, normalizedValue])
  @@index([recordId])
  @@index([fieldId])
}

model RecordRelationshipDefinition {
  fieldId        String @id
  targetModuleId String

  field        RecordField  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  targetModule RecordModule @relation("RelationshipTargetModule", fields: [targetModuleId], references: [id], onDelete: Restrict)

  @@index([targetModuleId])
}

model RecordRelationship {
  id             String @id @default(cuid())
  organizationId String
  fieldId        String
  sourceRecordId String
  targetRecordId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  field        RecordField  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  sourceRecord RecordItem   @relation("RelationshipSource", fields: [sourceRecordId], references: [id], onDelete: Cascade)
  targetRecord RecordItem   @relation("RelationshipTarget", fields: [targetRecordId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fieldId, sourceRecordId])
  @@index([sourceRecordId])
  @@index([targetRecordId])
  @@index([organizationId])
}

enum ModuleFeature {
  NOTES
  TASKS
  FILES
  EMAILS
  CALENDAR
}

enum RecordViewType {
  LIST
  KANBAN
  CALENDAR
  GALLERY
  GANTT
}

enum RecordFieldType {
  TEXT
  LONG_TEXT

  NUMBER
  CURRENCY
  PERCENT

  BOOLEAN

  DATE
  DATETIME

  EMAIL
  PHONE
  URL

  SELECT
  MULTI_SELECT

  RELATIONSHIP

  USER

  FILE
}

// Company model

model Company {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  website        String?
  industry       String?
  size           String? // "1-10", "11-50", "51-200", "201-500", "500+"
  address        String?
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id])
  createdBy      Member?         @relation("CompanyCreator", fields: [createdById], references: [id])
  contacts       Contact[]
  deals          Deal[]          @relation("CompanyDeals")
  tasks          Task[]          @relation("CompanyTasks")
  activities     Activity[]      @relation("CompanyActivities")
  tags           TagAssignment[]
  files          File[]          @relation("CompanyFiles")
  calendarEvents CalendarEvent[] @relation("CompanyCalendarEvents")
  linkedNotes    Note[]          @relation("CompanyNotes")
  emails         Email[]         @relation("CompanyEmails")

  @@index([organizationId])
  @@index([organizationId, name])
  @@map("companies")
}

model Contact {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  jobTitle       String?
  source         String? // WhatsApp, Website, Referral, etc.
  companyId      String?
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id])
  company        Company?        @relation(fields: [companyId], references: [id])
  createdBy      Member?         @relation("ContactCreator", fields: [createdById], references: [id])
  deals          Deal[]          @relation("ContactDeals")
  tasks          Task[]          @relation("ContactTasks")
  activities     Activity[]      @relation("ContactActivities")
  tags           TagAssignment[]
  files          File[]          @relation("ContactFiles")
  calendarEvents CalendarEvent[] @relation("ContactCalendarEvents")
  linkedNotes    Note[]          @relation("ContactNotes")
  emails         Email[]         @relation("ContactEmails")

  @@index([organizationId])
  @@index([organizationId, companyId])
  @@index([organizationId, name])
  @@map("contacts")
}

model Deal {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  value          Decimal?  @db.Decimal(12, 2)
  currency       String?   @default("USD")
  stage          DealStage @default(PROSPECT)
  status         String? // Custom sub-status
  source         String? // Where this deal came from
  category       String? // Product/service category
  expectedClose  DateTime?
  wonAt          DateTime?
  lostAt         DateTime?
  lostReason     String?
  contactId      String?
  companyId      String?
  assignedToId   String?
  createdById    String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id])
  contact        Contact?        @relation("ContactDeals", fields: [contactId], references: [id])
  company        Company?        @relation("CompanyDeals", fields: [companyId], references: [id])
  assignedTo     Member?         @relation("AssignedDeals", fields: [assignedToId], references: [id])
  createdBy      Member?         @relation("DealCreator", fields: [createdById], references: [id])
  tasks          Task[]          @relation("DealTasks")
  activities     Activity[]      @relation("DealActivities")
  followUps      FollowUp[]
  tags           TagAssignment[]
  files          File[]          @relation("DealFiles")
  calendarEvents CalendarEvent[] @relation("DealCalendarEvents")
  linkedNotes    Note[]          @relation("DealNotes")
  emails         Email[]         @relation("DealEmails")

  @@index([organizationId, stage])
  @@index([organizationId, assignedToId])
  @@index([organizationId, contactId])
  @@index([organizationId, companyId])
  @@index([organizationId, createdAt])
  @@map("deals")
}

enum DealStage {
  PROSPECT
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Task {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         TaskStatus @default(TODO)
  dueDate        DateTime?
  assignedToId   String?
  dealId         String?
  contactId      String?
  companyId      String?
  createdById    String?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  recordId String?
  record   RecordItem? @relation(fields: [recordId], references: [id], onDelete: Cascade)

  organization Organization @relation(fields: [organizationId], references: [id])
  assignedTo   Member?      @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy    Member?      @relation("TaskCreator", fields: [createdById], references: [id])
  deal         Deal?        @relation("DealTasks", fields: [dealId], references: [id])
  contact      Contact?     @relation("ContactTasks", fields: [contactId], references: [id])
  company      Company?     @relation("CompanyTasks", fields: [companyId], references: [id])

  @@index([organizationId, recordId])
  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
  @@index([organizationId, dueDate])
  @@index([organizationId, contactId])
  @@index([organizationId, companyId])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

model FollowUp {
  id             String    @id @default(cuid())
  organizationId String
  dealId         String
  type           String // Call back, Follow up, Send quote, Send Email
  dueAt          DateTime
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  deal Deal @relation(fields: [dealId], references: [id])

  @@index([organizationId, dueAt])
  @@map("follow_ups")
}

// ─── Activity / Audit System ───

model Activity {
  id String @id @default(cuid())

  // Multi-tenancy
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Actor
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  // Activity origin
  source ActivitySource @default(MANUAL)

  // Core activity semantics
  activityType ActivityType
  channel      ActivityChannel?
  outcome      ActivityOutcome?

  // Feed display
  title       String
  description String?

  // Flexible structured data
  metadata Json?

  // Related entities
  dealId String?
  deal   Deal?   @relation("DealActivities", fields: [dealId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation("ContactActivities", fields: [contactId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation("CompanyActivities", fields: [companyId], references: [id], onDelete: Cascade)

  recordId String?
  record   RecordItem? @relation(fields: [recordId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([memberId])
  @@index([dealId])
  @@index([contactId])
  @@index([companyId])
  @@index([recordId])
  @@index([activityType])
  @@index([channel])
  @@index([outcome])
  @@index([source])
  @@index([createdAt])
}

enum ActivitySource {
  MANUAL
  SYSTEM
  AUTOMATION
  INTEGRATION
  AI
}

enum ActivityType {
  // Communication
  CALL
  MESSAGE
  EMAIL
  MEETING

  // Record changes
  NOTE
  TASK
  STATUS_CHANGE
  STAGE_CHANGE
  ASSIGNMENT

  // Lifecycle events
  CREATION
  DELETION

  // Misc
  FILE
  SYSTEM
}

enum ActivityChannel {
  PHONE
  WHATSAPP
  GMAIL
  OUTLOOK
  MANUAL
}

enum ActivityOutcome {
  // Call outcomes
  NO_ANSWER
  VOICEMAIL
  ANSWERED

  // Message/email outcomes
  DELIVERED
  OPENED
  READ
  REPLIED

  // Meeting outcomes
  SCHEDULED
  COMPLETED
  CANCELED
  RESCHEDULED

  // Generic operational outcomes
  FOLLOWUP_REQUIRED
  SUCCESS
  FAILED
}

// ─── Notes ───

model Note {
  id             String   @id @default(cuid())
  organizationId String
  title          String   @default("")
  content        String
  dealId         String?
  contactId      String?
  companyId      String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  recordId String?
  record   RecordItem? @relation(fields: [recordId], references: [id], onDelete: Cascade)

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    Member       @relation("NoteCreator", fields: [createdById], references: [id])
  deal         Deal?        @relation("DealNotes", fields: [dealId], references: [id])
  contact      Contact?     @relation("ContactNotes", fields: [contactId], references: [id])
  company      Company?     @relation("CompanyNotes", fields: [companyId], references: [id])

  @@index([organizationId, recordId])
  @@index([organizationId, dealId])
  @@index([organizationId, contactId])
  @@index([organizationId, companyId])
  @@map("notes")
}

// ─── Tags ───

model Tag {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  color          String?

  organization Organization    @relation(fields: [organizationId], references: [id])
  assignments  TagAssignment[]

  @@unique([organizationId, name])
  @@map("tags")
}

model TagAssignment {
  id        String  @id @default(cuid())
  tagId     String
  dealId    String?
  contactId String?
  companyId String?

  tag     Tag      @relation(fields: [tagId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@map("tag_assignments")
}

// ─── Files & Folders ───

enum FileType {
  FILE
  FOLDER
}

enum FileSource {
  SUPABASE
  GOOGLE_DRIVE
  DROPBOX
  ONEDRIVE
}

model File {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  type           FileType   @default(FILE)
  source         FileSource @default(SUPABASE)

  // For SUPABASE-hosted files
  storagePath String? // Path in the bucket: "{orgId}/{entityType}/{entityId}/{...nested}/filename"
  fileSize    Int?
  mimeType    String?

  // For third-party linked files
  externalUrl String?
  externalId  String? // ID in the external system

  // Nesting (self-referential)
  parentId String?
  parent   File?   @relation("FileChildren", fields: [parentId], references: [id])
  children File[]  @relation("FileChildren")

  // Entity scoping (which record this file tree belongs to)
  dealId    String?
  contactId String?
  companyId String?

  recordId String?
  record   RecordItem? @relation(fields: [recordId], references: [id], onDelete: Cascade)

  // Audit
  uploadedById String // Member ID
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  deal         Deal?        @relation("DealFiles", fields: [dealId], references: [id])
  contact      Contact?     @relation("ContactFiles", fields: [contactId], references: [id])
  company      Company?     @relation("CompanyFiles", fields: [companyId], references: [id])

  @@index([organizationId, recordId])
  @@index([parentId])
  @@index([organizationId, dealId])
  @@index([organizationId, contactId])
  @@index([organizationId, companyId])
  @@map("files")
}

// ─── Google Calendar ───

model CalendarEvent {
  id             String @id @default(cuid())
  googleEventId  String
  userId         String
  organizationId String
  calendarId     String @default("primary")

  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime
  allDay      Boolean  @default(false)
  status      String? // confirmed, tentative, cancelled
  htmlLink    String? // Link to event in Google Calendar
  attendees   Json? // Array of { email, displayName, responseStatus }

  // CRM entity links
  dealId    String?
  contactId String?
  companyId String?

  // Sync metadata
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation("DealCalendarEvents", fields: [dealId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation("ContactCalendarEvents", fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?     @relation("CompanyCalendarEvents", fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId, googleEventId])
  @@index([organizationId, startTime])
  @@index([organizationId, dealId])
  @@index([organizationId, contactId])
  @@index([organizationId, companyId])
  @@index([userId, startTime])
  @@map("calendar_events")
}

// ─── Mailbox ───

model Email {
  id                String @id @default(cuid())
  provider          String // "google_gmail" | "microsoft_outlook"
  providerMessageId String
  providerThreadId  String
  userId            String
  organizationId    String

  subject String?
  snippet String?
  body    String? // Full decoded body (HTML preferred, fallback to plain)
  from    String // "Name <email@example.com>"
  to      String[]
  cc      String[] @default([])
  bcc     String[] @default([])
  replyTo String?

  isRead     Boolean  @default(false)
  isStarred  Boolean  @default(false)
  isSent     Boolean  @default(false)
  isDraft    Boolean  @default(false)
  isArchived Boolean  @default(false)
  labelIds   String[] @default([])

  hasAttachments Boolean  @default(false)
  sentAt         DateTime

  // CRM entity links
  dealId    String?
  contactId String?
  companyId String?

  // Sync metadata
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation("DealEmails", fields: [dealId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation("ContactEmails", fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?     @relation("CompanyEmails", fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId, provider, providerMessageId])
  @@index([organizationId, sentAt])
  @@index([organizationId, providerThreadId])
  @@index([userId, provider, isArchived, sentAt])
  @@index([organizationId, dealId])
  @@index([organizationId, contactId])
  @@index([organizationId, companyId])
  @@map("emails")
}

// ─── Notifications ───
model Notification {
  id             String @id @default(cuid())
  organizationId String
  recipientId    String

  type  String // task_assigned, follow_up_due, deal_assigned
  title String
  body  String?
  link  String?
  data  Json? // structured payload (taskId, dealId, etc.)

  status      NotificationStatus @default(PENDING) // PENDING, SENT, FAILED
  readAt      DateTime?
  sentAt      DateTime? // when it actually went out, vs scheduledAt = when it should
  scheduledAt DateTime           @default(now()) // give it a default so instant notifs don't need to pass it

  dedupeKey String? // optional, for idempotency on retries

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    Member       @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  deliveries NotificationDelivery[]

  @@unique([organizationId, recipientId, type, dedupeKey])
  @@index([recipientId, readAt, createdAt])
  @@index([organizationId, scheduledAt, status]) // for the worker's "what's due" query
  @@map("notifications")
}

// for channel handlers (in-app, email, push) each handle own their own delivery row and lifecycle.
model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel String // in_app, email, push
  status  String // PENDING, SENT, FAILED
  sentAt  DateTime?
  error   String?

  createdAt DateTime @default(now())

  @@index([notificationId])
  @@map("notification_deliveries")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}
